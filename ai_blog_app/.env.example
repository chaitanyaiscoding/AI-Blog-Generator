# Copy this file to .env and fill in your own values.
DB_NAME=ai_blog_generator
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5433

# Used by blog_generator/views.py to generate articles. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Optional Django overrides (defaults suit local development).
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=False
# On EC2, add the instance's public IP (or domain), e.g. localhost,127.0.0.1,13.233.10.20
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
