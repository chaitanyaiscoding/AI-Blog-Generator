# Copy this file to .env and fill in your own values.
DB_NAME=ai_blog_generator
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5433

# RabbitMQ (Celery's message broker). Required with docker compose: the rabbitmq
# container creates this user on first start (its built-in "guest" user only accepts
# connections from inside its own container). Leave them unset locally to use
# guest/guest@localhost:5672, e.g. with
#   docker run -d -p 5672:5672 -p 15672:15672 rabbitmq:4-management
RABBITMQ_DEFAULT_USER=blog
RABBITMQ_DEFAULT_PASS=your-rabbitmq-password
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672

# Used by blog_generator/generation.py to generate articles. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Optional Django overrides (defaults suit local development).
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=False
# On EC2, add the instance's public IP (or domain), e.g. localhost,127.0.0.1,13.233.10.20
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
